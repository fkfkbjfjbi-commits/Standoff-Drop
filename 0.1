<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>STANDOFF DROP - Premium Edition</title>
    <script src="https://telegram.org"></script>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; font-family: 'Segoe UI', Roboto, sans-serif; }
        body { background: #07040d; color: #e2e1e6; padding: 15px; text-align: center; }
        
        /* Фиолетовая неоновая тема под твой логотип */
        .header { background: linear-gradient(135deg, #130a29, #1d0f3c); padding: 15px; border-radius: 14px; margin-bottom: 15px; border: 2px solid #8a2be2; box-shadow: 0 0 20px rgba(138, 43, 226, 0.4); }
        .balance { font-size: 26px; font-weight: bold; color: #d8b4fe; text-shadow: 0 0 10px rgba(216, 180, 254, 0.6); margin-top: 5px; }
        
        /* Навигация */
        .tabs { display: flex; gap: 5px; margin-bottom: 20px; overflow-x: auto; padding-bottom: 5px; }
        .tab-btn { background: #160d29; border: 1px solid #5c1d99; color: #a7a2c4; padding: 10px 14px; border-radius: 10px; font-weight: bold; font-size: 13px; cursor: pointer; white-space: nowrap; transition: 0.2s; }
        .tab-btn.active { background: #8a2be2; color: #fff; box-shadow: 0 0 12px rgba(138, 43, 226, 0.7); border-color: #c084fc; }
        
        .page { display: none; text-align: left; }
        .page.active { display: block; }
        .page-title { font-size: 20px; font-weight: bold; margin-bottom: 15px; color: #fff; text-align: center; }

        /* Модели Кейсов (Неоновые боксы) */
        .case-icon-box { width: 60px; height: 50px; background: linear-gradient(135deg, #3a0ca3, #7209b7); border: 2px solid #b5179e; border-radius: 6px; box-shadow: 0 0 10px rgba(181, 23, 158, 0.5); display: inline-block; vertical-align: middle; margin-right: 15px; position: relative; }
        .case-icon-box::after { content: 'SO2'; position: absolute; bottom: 2px; right: 4px; font-size: 9px; color: #4cc9f0; font-weight: bold; }

        /* Иконка Скина */
        .skin-icon-visual { width: 45px; height: 45px; border-radius: 8px; display: inline-block; vertical-align: middle; margin-right: 12px; position: relative; background: #1a162b; }
        .skin-icon-visual::before { content: '🔫'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-size: 20px; }

        /* Тапалка */
        .click-stage { display: flex; flex-direction: column; align-items: center; margin: 30px 0; }
        .click-coin { background: linear-gradient(135deg, #5c1d99, #8a2be2); border: 3px solid #c084fc; width: 140px; height: 140px; border-radius: 50%; font-size: 50px; cursor: pointer; box-shadow: 0 0 30px rgba(138, 43, 226, 0.9); display: flex; align-items: center; justify-content: center; transition: transform 0.05s; }
        .click-coin:active { transform: scale(0.93); }

        /* Сетка Кейсов */
        .cases-grid { display: grid; grid-template-columns: 1fr; gap: 15px; }
        .case-card { background: #110922; border: 1px solid #5c1d99; border-radius: 14px; padding: 18px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 4px 15px rgba(0,0,0,0.5); }
        .case-meta { display: flex; align-items: center; }
        .case-title { font-size: 18px; font-weight: bold; color: #fff; }
        .case-price { color: #c084fc; font-weight: bold; margin-top: 3px; font-size: 15px; }
        .btn-open { background: #8a2be2; color: white; border: none; padding: 10px 20px; font-size: 15px; font-weight: bold; border-radius: 8px; cursor: pointer; border: 1px solid #c084fc; box-shadow: 0 0 10px rgba(138, 43, 226, 0.4); }
        .btn-open:active { background: #5c1d99; }
        .drop-result { font-size: 18px; margin-top: 15px; font-weight: bold; padding: 14px; border-radius: 8px; text-align: center; display: none; }

        /* Редкости по цветам из игры */
        .rare-common { color: #b3b0cb; border-color: #b3b0cb; box-shadow: inset 0 0 6px rgba(179,176,203,0.2); }
        .rare-rare { color: #4287f5; border-color: #4287f5; box-shadow: inset 0 0 6px rgba(66,135,245,0.2); }
        .rare-epic { color: #bf5af2; border-color: #bf5af2; text-shadow: 0 0 4px rgba(191,90,242,0.3); box-shadow: inset 0 0 6px rgba(191,90,242,0.2); }
        .rare-legendary { color: #ff3b30; border-color: #ff3b30; text-shadow: 0 0 6px rgba(255,59,48,0.4); box-shadow: inset 0 0 8px rgba(255,59,48,0.2); }
        .rare-arcane { color: #ff2d55; border-color: #ff2d55; text-shadow: 0 0 10px rgba(255,45,85,0.6); box-shadow: inset 0 0 12px rgba(255,45,85,0.3); border-width: 2px; }

        /* Элементы Списков */
        .card-list { background: #110922; border: 1px solid #3d1866; border-radius: 12px; padding: 12px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .skin-info-block { display: flex; align-items: center; }
        .btn-sell { background: #ff3b30; border: 1px solid #ff453a; color: white; padding: 8px 14px; border-radius: 6px; font-weight: bold; cursor: pointer; }
        
        /* Апгрейды */
        .upgrade-container { background: #110922; border: 1px solid #5c1d99; padding: 20px; border-radius: 14px; margin-bottom: 15px; }
        .upgrade-label { font-size: 14px; color: #a7a2c4; margin-bottom: 6px; display: block; font-weight: bold; }
        .upgrade-select { background: #160d29; color: white; padding: 12px; border-radius: 8px; width: 100%; border: 1px solid #5c1d99; margin-bottom: 15px; font-size: 15px; }
        .chance-display { text-align: center; margin: 20px 0; padding: 15px; background: rgba(138, 43, 226, 0.1); border-radius: 10px; border: 1px dashed #8a2be2; }
        .chance-percent { font-size: 32px; font-weight: bold; color: #5ac8fa; text-shadow: 0 0 10px rgba(90,200,250,0.5); }

        /* Лидеры */
        .top-table { width: 100%; border-collapse: collapse; background: #110922; border: 1px solid #5c1d99; border-radius: 14px; overflow: hidden; }
        .top-table th, .top-table td { padding: 12px 15px; text-align: left; border-bottom: 1px solid #1c0f38; }
        .top-table th { background: #160d29; color: #c084fc; font-size: 14px; }
        .top-user.me { color: #5ac8fa; }
    </style>
</head>
<body>

    <!-- Наш баланс -->
    <div class="header">
        <div style="color: #a7a2c4; font-size: 14px; letter-spacing: 2px; font-weight: bold;">STANDOFF DROP</div>
        <div class="balance"><span id="balance-val">100.00</span> G</div>
    </div>

    <!-- Вкладки Навигации -->
    <div class="tabs">
        <button class="tab-btn active" onclick="switchTab('click-page')">🪙 Фарм</button>
        <button class="tab-btn" onclick="switchTab('cases-page')">📦 Кейсы</button>
        <button class="tab-btn" onclick="switchTab('inv-page')">🎒 Инвентарь (<span id="inv-count">0</span>)</button>
        <button class="tab-btn" onclick="switchTab('upgrade-page')">⚡ Апгрейд</button>
        <button class="tab-btn" onclick="switchTab('tasks-page')">🎯 Задания</button>
        <button class="tab-btn" onclick="switchTab('top-page')">🏆 Топ</button>
    </div>

    <!-- ФАРМ -->
    <div id="click-page" class="page active">
        <div class="click-stage">
            <p style="color: #a7a2c4; margin-bottom: 25px;">Тапай, чтобы нафармить голду на кейсы!</p>
            <button class="click-coin" id="clicker">💎</button>
        </div>
    </div>

    <!-- КЕЙСЫ (РЕАЛЬНЫЕ ЦЕНЫ) -->
    <div id="cases-page" class="page">
        <h3 class="page-title">Официальные кейсы Standoff 2</h3>
        <div class="cases-grid">
            <div class="case-card">
                <div class="case-meta">
                    <div class="case-icon-box" style="background: linear-gradient(135deg, #ff9f1c, #ffbf69);"></div>
                    <div>
                        <div class="case-title">📦 Fable Case</div>
                        <div class="case-price">30.00 G</div>
                    </div>
                </div>
                <button class="btn-open" onclick="openCase(30, 'fable')">Открыть</button>
            </div>
            
            <div class="case-card">
                <div class="case-meta">
                    <div class="case-icon-box" style="background: linear-gradient(135deg, #00b4d8, #0077b6);"></div>
                    <div>
                        <div class="case-title">📦 Sharp Case</div>
                        <div class="case-price">30.00 G</div>
                    </div>
                </div>
                <button class="btn-open" onclick="openCase(30, 'sharp')">Открыть</button>
            </div>

            <div class="case-card">
                <div class="case-meta">
                    <div class="case-icon-box" style="background: linear-gradient(135deg, #7209b7, #3f37c9);"></div>
                    <div>
                        <div class="case-title">📦 Origin Case</div>
                        <div class="case-price">35.00 G</div>
                    </div>
                </div>
                <button class="btn-open" onclick="openCase(35, 'origin')">Открыть</button>
            </div>
        </div>
        <div id="drop-res" class="drop-result"></div>
    </div>

    <!-- ИНВЕНТАРЬ -->
    <div id="inv-page" class="page">
        <h3 class="page-title">Твой инвентарь скинов</h3>
        <div id="inventory-list"></div>
    </div>

    <!-- АПГРЕЙД -->
    <div id="upgrade-page" class="page">
        <h3 class="page-title">Рыночный Апгрейд</h3>
        <div class="upgrade-container">
            <label class="upgrade-label">Твой скин для обмена:</label>
            <select id="my-skin-select" class="upgrade-select" onchange="calculateUpgradeChance()">
                <option value="">-- Выбери свой скин --</option>
            </select>

            <label class="upgrade-label">Скин-цель (Желаемый скин):</label>
